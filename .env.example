# Copie para .env (ignorado pelo git). Valores abaixo servem só ao desenvolvimento local.
# Segredos de produção ficam somente no Coolify.

# crm-api
PORT=3000
DATABASE_URL=postgresql://zarco:zarco@localhost:5436/zarco
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h
UPLOAD_DIR=./uploads

# Banco dos testes de integração (serviço postgres-test do docker compose).
# Os testes apagam dados: nunca aponte para o banco de desenvolvimento.
TEST_DATABASE_URL=postgresql://zarco:zarco@localhost:5435/zarco_test

# landing (variáveis lidas no build)
PUBLIC_WHATSAPP_NUMBER=
PUBLIC_WHATSAPP_MESSAGE=
