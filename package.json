{
  "name": "zarco-ecossystem",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev:api": "pnpm --filter crm-api dev",
    "dev:crm-web": "pnpm --filter crm-web dev",
    "dev:landing": "pnpm --filter landing dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d --wait postgres postgres-test",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "astro": "7.3.8",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
