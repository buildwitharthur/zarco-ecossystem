---
// S3 · Faixa de sintomas (RF-LP-10). Sem números inventados.
const symptoms = [
  'planilha_pedidos_final_v7_AGORA_VAI.xlsx',
  '“quem atualizou essa planilha?”',
  'pedido digitado de novo no sistema',
  '“me manda de novo no WhatsApp?”',
  'conferência manual toda sexta',
  'três versões do mesmo relatório',
  '“só o fulano sabe mexer nisso”',
  'copiar, colar, conferir, repetir',
];
---

<div class="ticker" id="ticker" aria-label="Sintomas comuns de uma operação que passou da planilha">
  <div class="frame">
    <div>
      <span class="ticker__label idx">Soa familiar?</span>
      <div class="ticker__viewport">
        <div class="ticker__track">
          <ul>
            {symptoms.map((text) => (
              <li>{text}</li>
            ))}
          </ul>
          <ul aria-hidden="true">
            {symptoms.map((text) => (
              <li>{text}</li>
            ))}
          </ul>
        </div>
      </div>
      <button
        class="ticker__btn"
        type="button"
        id="ticker-btn"
        aria-label="Pausar a faixa"
        aria-pressed="false"
      >
        <svg aria-hidden="true">
          <use href="#i-pause"></use>
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  .ticker {
    position: relative;
    z-index: 1;
    border-block: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .frame > div {
    border-inline: 1px solid var(--color-line);
    display: flex;
    align-items: center;
    height: 48px;
  }
  .ticker__label {
    flex: none;
    padding: 0 16px;
    height: 100%;
    display: flex;
    align-items: center;
    border-right: 1px solid var(--color-line);
  }
  .ticker__viewport {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .ticker__track {
    display: flex;
    width: max-content;
    animation: tick 60s linear infinite;
  }
  .ticker__track ul {
    display: flex;
    gap: 40px;
    padding-right: 40px;
    font: 400 12.5px/1 var(--font-mono);
    color: var(--color-text-2);
    white-space: nowrap;
  }
  .ticker__track li::before {
    content: '·';
    margin-right: 40px;
    color: var(--color-line-2);
  }
  .ticker__track li:first-child::before {
    content: none;
  }
  /* B8: pausa por botão, hover (só com ponteiro), foco e fora da tela */
  .ticker:global(.is-paused) .ticker__track,
  .ticker:focus-within .ticker__track {
    animation-play-state: paused;
  }
  @media (hover: hover) {
    .ticker:hover .ticker__track {
      animation-play-state: paused;
    }
  }
  @keyframes tick {
    to {
      transform: translateX(-50%);
    }
  }

  /* Tecla de pausa */
  .ticker__btn {
    flex: none;
    width: 48px;
    height: 100%;
    display: grid;
    place-items: center;
    padding: 0;
    cursor: pointer;
    color: var(--color-text-2);
    border: 1px solid transparent;
    border-left-color: var(--color-line);
    border-radius: 0;
    background:
      linear-gradient(180deg, #26272c, #1a1b1e) padding-box,
      linear-gradient(
          180deg,
          var(--color-edge-hi),
          rgb(255 255 255 / 0.03) 50%,
          var(--color-edge-lo)
        )
        border-box;
    box-shadow:
      0 1px 2px var(--color-shade),
      inset 0 1px 0 rgb(255 255 255 / 0.06);
  }
  .ticker__btn:hover {
    color: var(--color-text);
  }
  .ticker__btn:active,
  .ticker__btn[aria-pressed='true'] {
    background:
      linear-gradient(180deg, #141518, #1c1d21) padding-box,
      linear-gradient(180deg, var(--color-edge-lo), rgb(255 255 255 / 0.08)) border-box;
    box-shadow: inset 0 2px 5px rgb(0 0 0 / 0.6);
  }
  .ticker__btn:focus-visible {
    outline-offset: -3px;
  }
  .ticker__btn svg {
    width: 12px;
    height: 12px;
  }

  @media (max-width: 639px) {
    .ticker__label {
      display: none;
    }
  }
  /* Sem JavaScript o botão não faria nada; e não há como pausar → a faixa fica parada */
  :global(html:not(.js)) .ticker__btn {
    display: none;
  }
  :global(html:not(.js)) .ticker__track {
    animation: none;
  }
  :global(html:not(.js)) .ticker__viewport {
    overflow-x: auto;
  }
  :global(html:not(.js)) .ticker__track ul[aria-hidden='true'] {
    display: none;
  }
  /* Com "movimento reduzido" a faixa fica parada, com a lista rolável (CA-TLP01.6) */
  @media (prefers-reduced-motion: reduce) {
    .ticker__viewport {
      overflow-x: auto;
    }
    .ticker__track ul[aria-hidden='true'] {
      display: none;
    }
  }
</style>

<script>
  import { onView, prefersReducedMotion } from '../scripts/in-view';

  const ticker = document.getElementById('ticker');
  const button = document.getElementById('ticker-btn');
  const use = button?.querySelector('use');

  if (ticker && button && use) {
    // Pausa do visitante (botão) e pausa por estar fora da tela são independentes.
    let userPaused = prefersReducedMotion();
    let visible = false;

    const render = () => {
      ticker.classList.toggle('is-paused', userPaused || !visible);
      button.setAttribute('aria-pressed', String(userPaused));
      button.setAttribute('aria-label', userPaused ? 'Retomar a faixa' : 'Pausar a faixa');
      use.setAttribute('href', userPaused ? '#i-play' : '#i-pause');
    };

    button.addEventListener('click', () => {
      userPaused = !userPaused;
      render();
    });
    onView(
      ticker,
      () => ((visible = true), render()),
      () => ((visible = false), render()),
    );
    render();
  }
</script>
