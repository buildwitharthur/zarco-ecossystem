---
import ReworkLoop from './ReworkLoop.astro';

// S4 · 01 / O problema (RF-LP-02): sintomas da operação, não tecnologia.
const cells = [
  {
    n: '001',
    tag: 'Planilha',
    title: 'O processo depende de planilha.',
    text: 'Conferência manual, copiar e colar e uma versão diferente em cada computador.',
  },
  {
    n: '002',
    tag: 'Dispersão',
    title: 'A informação está espalhada.',
    text: 'Pedido no WhatsApp, cadastro na planilha, status na cabeça de alguém.',
  },
  {
    n: '003',
    tag: 'Redigitação',
    title: 'Os sistemas não conversam.',
    text: 'A mesma informação é digitada duas vezes, em dois lugares, por pessoas diferentes.',
  },
  {
    n: '004',
    tag: 'Repetição',
    title: 'A tarefa se repete toda semana.',
    text: 'Horas da equipe em um trabalho que um sistema faria sozinho.',
  },
];
---

<section class="sec" aria-labelledby="t-prob">
  <div class="frame">
    <div class="inner">
      <div class="sec-head reveal">
        <p class="idx">
          <b>01</b> / O problema
        </p>
        <h2 class="h2" id="t-prob">
          Quando a operação já passou da planilha.
        </h2>
        <p>
          A informação existe, mas está em vários lugares. Alguém precisa juntar tudo, toda vez.
        </p>
      </div>
      <div class="problem reveal">
        {cells.map((cell) => (
          <div class="cell">
            <span class="idx">
              <b>{cell.n}</b>
              <span>{cell.tag}</span>
            </span>
            <h3 class="h3">{cell.title}</h3>
            <p>{cell.text}</p>
          </div>
        ))}
        <ReworkLoop />
      </div>
    </div>
  </div>
</section>

<style>
  .problem {
    display: grid;
    border: 1px solid var(--color-line-2);
  }
  @media (min-width: 900px) {
    .problem {
      grid-template-columns: 1fr 1fr 1.15fr;
      grid-template-rows: 1fr 1fr;
    }
    .problem > :global(.diagram) {
      grid-column: 3;
      grid-row: 1 / 3;
    }
  }
  .cell {
    padding: 28px;
    display: grid;
    gap: 12px;
    align-content: start;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-bg);
    transition: background 0.2s var(--ease-standard);
  }
  .cell .idx {
    display: flex;
    justify-content: space-between;
  }
  .cell p {
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--color-text-2);
  }
  @media (min-width: 900px) {
    .cell {
      padding: 32px;
      border-bottom: 0;
      border-right: 1px solid var(--color-line);
    }
    .cell:nth-child(-n + 2) {
      border-bottom: 1px solid var(--color-line);
    }
  }
  @media (max-width: 639px) {
    .cell {
      padding: 22px;
    }
  }
  /* R2: efeitos de hover só em dispositivos com ponteiro */
  @media (hover: hover) {
    .cell:hover {
      background: var(--color-surface);
    }
    .cell:hover .idx b {
      color: var(--color-accent);
    }
  }
</style>
