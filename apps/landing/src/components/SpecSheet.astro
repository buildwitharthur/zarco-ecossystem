---
// Ficha técnica: as três garantias (RF-LP-13). Painel em relevo (foundations §7.1).
const items = [
  { title: 'Diagnóstico gratuito', text: 'Primeiro entender onde o processo trava.' },
  { title: 'Escopo por escrito', text: 'O que está e o que não está incluído.' },
  { title: 'Código no seu nome', text: 'Documentado, em produção e seu.' },
];
---

<aside class="spec reveal" style="--i:4" aria-label="Como a Zarco trabalha">
  <div class="spec__head">
    <span class="idx">
      <b>Ficha</b>
    </span>
    <span class="idx">03 itens</span>
  </div>
  {items.map((item, i) => (
    <div class="spec__row">
      <span class="idx">{String(i + 1).padStart(2, '0')}</span>
      <strong>{item.title}</strong>
      <span>{item.text}</span>
    </div>
  ))}
</aside>

<style>
  .spec {
    border: 1px solid transparent;
    border-radius: 12px;
    overflow: hidden;
    background:
      linear-gradient(180deg, #1d1e22, #151619) padding-box,
      linear-gradient(
          180deg,
          var(--color-edge-hi),
          rgb(255 255 255 / 0.03) 40%,
          var(--color-edge-lo)
        )
        border-box;
    box-shadow:
      0 1px 2px var(--color-shade),
      0 24px 48px -24px rgb(0 0 0 / 0.8),
      inset 0 1px 0 rgb(255 255 255 / 0.06);
  }
  .spec__head {
    display: flex;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-line-2);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.035), transparent);
  }
  .spec__row {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 4px 10px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--color-line);
  }
  .spec__row:last-child {
    border-bottom: 0;
  }
  /* Poço escavado */
  .spec__row .idx {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 22px;
    margin-top: 3px;
    border-radius: 5px;
    font-size: 10.5px;
    background: rgb(0 0 0 / 0.3);
    box-shadow:
      inset 0 1px 3px rgb(0 0 0 / 0.6),
      0 1px 0 rgb(255 255 255 / 0.05);
  }
  .spec__row strong {
    font: 600 16px/1.3 var(--font-display);
    letter-spacing: -0.01em;
  }
  .spec__row span:last-child {
    grid-column: 2;
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-text-2);
  }
</style>
